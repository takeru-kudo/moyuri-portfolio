{
  "$schema": "../../tools/deployer/node_modules/wrangler/config-schema.json",
  "name": "csp-report",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "csp.moyuri-kudo.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "csp_reports",
      "database_id": "27b80eb7-dc69-4d44-9e78-667ab1b30a11",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["0 18 * * *"] }
}
