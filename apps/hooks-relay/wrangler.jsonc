{
  "$schema": "../../tools/deployer/node_modules/wrangler/config-schema.json",
  "name": "hooks-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "hooks.moyuri-kudo.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    "GITHUB_OWNER": "takeru-kudo",
    "GITHUB_REPO": "moyuri-portfolio",
    "GITHUB_APP_ID": "5885915",
    "GITHUB_INSTALLATION_ID": "184959815"
  }
}
