---
import Base from "../layouts/Base.astro";
import { getSiteContent } from "../lib/load.ts";

const { projects, site } = await getSiteContent();
const tagline = site?.tagline?.trim() || null;
---

<Base title="Moyuri Kudo">
  <h1>Moyuri Kudo</h1>
  {tagline && <p>{tagline}</p>}
  {
    projects.length === 0 ? (
      <>
        <p>準備中です。</p>
        <p lang="en">Portfolio coming soon.</p>
      </>
    ) : (
      <section aria-labelledby="projects-heading">
        <h2 id="projects-heading">Projects</h2>
        <ul>
          {projects.map((project) => (
            <li>
              <a href={`/projects/${project.slug}/`}>{project.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
