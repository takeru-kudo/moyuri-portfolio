{
  "$schema": "../../tools/deployer/node_modules/wrangler/config-schema.json",
  "name": "site",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "beta": {
      "routes": [{ "pattern": "beta.moyuri-kudo.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    },
    "prod": {
      "routes": [{ "pattern": "moyuri-kudo.com", "custom_domain": true }],
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
